{
  "name": "@floci/testcontainers",
  "version": "0.4.0",
  "description": "Testcontainers module for Floci, the open-source local cloud emulators for AWS, Azure, GCP and OCI",
  "keywords": [
    "testcontainers",
    "floci",
    "aws",
    "azure",
    "gcp",
    "oci",
    "testing"
  ],
  "license": "MIT",
  "homepage": "https://github.com/floci-io/testcontainers-floci-node",
  "repository": {
    "type": "git",
    "url": "https://github.com/floci-io/testcontainers-floci-node.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --testPathPattern='tests/unit'",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern='tests/integration'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "testcontainers": "^10.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "^3.0.0",
    "@aws-sdk/client-api-gateway": "^3.0.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-ecr": "^3.0.0",
    "@aws-sdk/client-eventbridge": "^3.0.0",
    "@aws-sdk/client-firehose": "^3.0.0",
    "@aws-sdk/client-iam": "^3.0.0",
    "@aws-sdk/client-kinesis": "^3.0.0",
    "@aws-sdk/client-kms": "^3.0.0",
    "@aws-sdk/client-lambda": "^3.0.0",
    "@aws-sdk/client-rds": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "@aws-sdk/client-ses": "^3.0.0",
    "@aws-sdk/client-sfn": "^3.0.0",
    "@aws-sdk/client-sns": "^3.0.0",
    "@aws-sdk/client-sqs": "^3.0.0",
    "@aws-sdk/client-ssm": "^3.0.0",
    "@azure/storage-blob": "~12.27.0",
    "@azure/storage-queue": "~12.26.0",
    "@google-cloud/pubsub": "^4.11.0",
    "@google-cloud/storage": "^7.22.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "oci-common": "^2.142.2",
    "oci-objectstorage": "^2.142.2",
    "ts-jest": "^29.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
